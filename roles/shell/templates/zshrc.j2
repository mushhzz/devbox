# {{ ansible_managed }}
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="{{ omz_theme }}"

plugins=(
{% for plugin in omz_plugins %}
    {{ plugin }}
{% endfor %}
)

source $ZSH/oh-my-zsh.sh

# --- macOS Homebrew PATH ---
{% if ansible_os_family == "Darwin" %}
if [ -d "/opt/homebrew/bin" ]; then
    export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
fi

if [ -d "/usr/local/bin" ]; then
    export PATH="/usr/local/bin:$PATH"
fi
{% endif %}

# --- Plugin config ---

# history-substring-search: up/down arrows search history by prefix
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# fzf-tab config
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:*' fzf-min-height 20

# ssh-agent: auto-add keys
zstyle :omz:plugins:ssh-agent identities id_ed25519

# --- PATH additions ---

# Rust (rustup/cargo)
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"

# Go
export GOPATH="$HOME/go"
export PATH="$GOPATH/bin:$PATH"

# fnm (Node.js)
if [ -d "$HOME/.local/share/fnm" ]; then
    export PATH="$HOME/.local/share/fnm:$PATH"
    eval "$(fnm env --use-on-cd --shell zsh)"
fi

# .NET SDK
if [ -d "$HOME/.dotnet" ]; then
    export DOTNET_ROOT="$HOME/.dotnet"
    export PATH="$DOTNET_ROOT:$DOTNET_ROOT/tools:$PATH"
fi

# uv / uvx (Python)
[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"

# Google Cloud SDK
{% if ansible_os_family == "Darwin" %}
if [ -f "/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/path.zsh.inc" ]; then
    source "/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/path.zsh.inc"
    source "/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/completion.zsh.inc"
fi
{% else %}
if [ -f "$HOME/.local/share/google-cloud-sdk/path.zsh.inc" ]; then
    source "$HOME/.local/share/google-cloud-sdk/path.zsh.inc"
    source "$HOME/.local/share/google-cloud-sdk/completion.zsh.inc"
fi
{% endif %}

# --- Tool integrations ---

# zoxide (smart cd)
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"

# fzf
command -v fzf &>/dev/null && eval "$(fzf --zsh)"

# --- Aliases ---
command -v bat &>/dev/null && alias cat="bat --paging=never"
command -v eza &>/dev/null && alias ls="eza" && alias ll="eza -la" && alias lt="eza --tree"
command -v btop &>/dev/null && alias top="btop"